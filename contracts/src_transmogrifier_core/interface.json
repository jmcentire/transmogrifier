  "functions": [
    {
      "name": "__init__",
      "description": "Initializes a Transmogrifier instance with optional profile cache and configuration. Creates internal detector, classifier, and rule engine instances.",
      "inputs": [
        {
          "name": "self",
          "type_ref": "Transmogrifier",
          "required": true,
          "default": "",
          "description": "Instance reference",
          "validators": []
        },
        {
          "name": "profile_cache",
          "type_ref": "ProfileCache | None",
          "required": false,
          "default": "None",
          "description": "Optional profile cache; creates new instance if not provided",
          "validators": []
        },
        {
          "name": "config",
          "type_ref": "TranslationConfig | None",
          "required": false,
          "default": "None",
          "description": "Optional translation config; creates default if not provided",
          "validators": []
        }
      ],
      "output_type": "None",
      "error_cases": [],
      "preconditions": [],
      "postconditions": [
        "self._detector is initialized with RegisterDetector()",
        "self._task_classifier is initialized with TaskClassifier()",
        "self._profile_cache is set to provided cache or new ProfileCache()",
        "self._rule_engine is initialized with RuleEngine()",
        "self._config is set to provided config or new TranslationConfig()"
      ],
      "idempotent": false,
      "is_async": false,
      "side_effects": [
        "Instantiates RegisterDetector, TaskClassifier, RuleEngine, and optionally ProfileCache and TranslationConfig"
      ],
      "structured_side_effects": [
        {
          "kind": "mutates_state",
          "target": "self",
          "description": "Initializes all instance attributes"
        }
      ],
      "performance_budget": null
    },
    {
      "name": "translate",
      "description": "Translates input text to optimal register for the specified model. Performs register detection, task classification, profile lookup, and rule-based rewriting. Zero API calls - all processing is local.",
      "inputs": [
        {
          "name": "self",
          "type_ref": "Transmogrifier",
          "required": true,
          "default": "",
          "description": "Instance reference",
          "validators": []
        },
        {
          "name": "text",
          "type_ref": "str",
          "required": true,
          "default": "",
          "description": "Input text to translate",
          "validators": []
        },
        {
          "name": "model",
          "type_ref": "str",
          "required": false,
          "default": "\"\"",
          "description": "Model identifier for profile lookup; empty string skips profile lookup",
          "validators": []
        },
        {
          "name": "config",
          "type_ref": "TranslationConfig | None",
          "required": false,
          "default": "None",
          "description": "Per-call config override; uses instance config if not provided",
          "validators": []
        }
      ],
      "output_type": "TranslationResult",
      "error_cases": [
        {
          "name": "ValueError from Register enum",
          "condition": "If target is a string not in Register enum values",
          "error_type": "ValueError",
          "error_data": {}
        }
      ],
      "preconditions": [],
      "postconditions": [
        "Returns TranslationResult with input_text == text",
        "Returns TranslationResult with detected_register set from detector",
        "Returns TranslationResult with target_register determined by config/profile/default",
        "Returns TranslationResult with system_prompt from get_system_prompt(detected, target)",
        "Returns TranslationResult with elapsed_ms >= 0",
        "Returns TranslationResult with trace_id as 12-character hex string",
        "If profile.is_invariant and task_spread < 2.0: returns skipped=True with output_text == text",
        "If detected != target: output_text is rewritten via rule_engine, level_applied = TranslationLevel.rule_rewrite",
        "If detected == target: output_text == text, level_applied = TranslationLevel.system_prompt"
      ],
      "idempotent": false,
      "is_async": false,
      "side_effects": [
        "Calls time.perf_counter() twice for timing",
        "Calls self._detector.detect(text)",
        "Calls self._task_classifier.classify(text)",
        "Conditionally calls self._profile_cache.get(model) if model is non-empty",
        "Conditionally calls profile.spread_for_task(task_type.value) if profile exists and config.task_aware",
        "Conditionally calls profile.best_register_for_task(task_type.value) or profile.best_register",
        "Calls get_system_prompt(detected, target)",
        "Conditionally calls self._rule_engine.rewrite(text, detected, target) if detected != target"
      ],
      "structured_side_effects": [
        {
          "kind": "reads_file",
          "target": "ProfileCache",
          "description": "May read cached model profiles"
        },
        {
          "kind": "logging",
          "target": "",
          "description": "No explicit logging, but timing is recorded in result"
        }
      ],
      "performance_budget": {
        "p95_latency_ms": null,
        "max_memory_mb": null,
        "complexity": "O(n)"
      }
    }
  ],
  "dependencies": [
    "time",
    "uuid",
    "pydantic",
    "src.transmogrifier.detector",
    "src.transmogrifier.profiles",
    "src.transmogrifier.rules",
    "src.transmogrifier.system_prompts",
    "src.transmogrifier.task_classifier"
  ],
  "dependency_contracts": {
    "src.transmogrifier.detector": [
      "RegisterDetector.detect"
    ],
    "src.transmogrifier.profiles": [
      "ProfileCache",
      "ProfileCache.get"
    ],
    "src.transmogrifier.rules": [
      "RuleEngine",
      "RuleEngine.rewrite"
    ],
    "src.transmogrifier.system_prompts": [
      "get_system_prompt"
    ],
    "src.transmogrifier.task_classifier": [
      "TaskClassifier",
      "TaskClassifier.classify",
      "TaskType"
    ]
  },
  "invariants": [
    "TranslationLevel.system_prompt (1) < TranslationLevel.rule_rewrite (2) < TranslationLevel.llm_translate (3)",
    "If detected_register == target_register, level_applied is always TranslationLevel.system_prompt",
    "If detected_register != target_register and max_level >= rule_rewrite, level_applied is TranslationLevel.rule_rewrite",
    "system_prompt is always generated regardless of whether rewriting occurs",
    "elapsed_ms is always >= 0",
    "trace_id is always a 12-character hexadecimal string",
    "If skipped=True, output_text == input_text"
  ],
  "requires": [],
  "processing_register": "",
  "data_access": {
    "reads": [
      "profile_cache"
    ],
    "writes": [],
    "rationale": "Reads model profiles from cache but does not persist any data",
    "side_effects": []
  },
  "authority": {
    "domains": [
      "prompt_translation",
      "register_detection"
    ],
    "rationale": "Owns the orchestration logic for translating prompts between linguistic registers"
  }
}